---
import "../styles.css";
import "../docs.css";
import CodeBlock from "../components/CodeBlock.astro";
import ScreenshotCard from "../components/ScreenshotCard.astro";
import dashboard from "../../docs/image/LunaDash-20260920-024312-792.png";
import appearance from "../../docs/image/LunaDash-20260920-024259-008.png";
import workspace from "../../docs/image/LunaDash-20260920-024708-948.png";
import calendar from "../../docs/image/LunaDash-20260920-024455-959.png";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = new URL(base, Astro.site).toString();
const asset = (name: string): string => `${base}assets/${name}`;
const repository = "https://github.com/LuYishan-4/LunaDash";
const profile = "https://github.com/LuYishan-4";
const avatar = "https://luyishan-4-blog.wuming381906.workers.dev/assets/images/avatar.webp";

const build = `git clone --branch dev ${repository}.git
cd LunaDash
./scripts/install-session.sh`;
const shortcuts: Array<[string, string]> = [
  ["Super (tap) / Super + D", "Open the launcher"],
  ["Super + T / E", "Terminal / file manager"],
  ["Super + W", "Wallpaper library"],
  ["Super + Shift + S", "Select a screenshot region (Escape cancels)"],
  ["Super + H / L", "Focus the column to the left / right"],
  ["Super + Shift + H / L", "Move the window into the left / right column"],
  ["Super + Shift + Space", "Switch tiling between Fill and Normal (niri-like)"],
  ["Super + F", "Maximize one window or restore the workspace"],
  ["Super + C / M", "Close / minimize the focused window"],
  ["Alt + Tab", "Every window in the taskbar; release Alt to switch"],
  ["Super + Tab", "Workspaces; release Super to switch"],
  ["Super + 1–9 / 0", "Switch workspace; add Shift to move the window"],
  ["Alt + left-drag", "Move directly; add Shift to resize"]
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="LunaDash is an open-source Linux Wayland desktop environment built with wlroots and a Slint shell, with dynamic workspaces, niri-like or screen-filling tiling, video wallpapers and a customizable panel, dock and launcher.">
  <meta name="keywords" content="Linux desktop environment, Wayland desktop, wlroots, Slint, SlintLu, desktop shell, Wayland compositor, tiling, customizable desktop, Arch Linux desktop">
  <link rel="canonical" href={canonical}>
  <meta property="og:title" content="LunaDash — Linux Wayland desktop environment">
  <meta property="og:description" content="An open-source, customizable Linux Wayland desktop environment built with wlroots and a Slint shell.">
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta name="theme-color" content="#101b1d">
  <title>LunaDash — Linux Wayland desktop environment</title>
  <link rel="icon" href={asset("mark.svg")} type="image/svg+xml">
  <script>import "../app";</script>
</head>
<body>
<div id="boot" aria-hidden="true">
  <div class="boot-lockup">
    <svg class="boot-mark" viewBox="0 0 126 126" aria-hidden="true">
      <path class="boot-orbit" d="M18 72 C24 103 58 119 88 104 C111 93 121 67 112 43" />
      <path class="boot-moon" d="M65 11 C38 17 23 43 31 69 C39 96 70 110 95 97 C77 96 60 85 53 68 C44 47 50 25 65 11 Z" />
      <path class="boot-star-a" d="M92 19 L95 27 L103 30 L95 33 L92 41 L89 33 L81 30 L89 27 Z" />
      <path class="boot-star-b" d="M105 54 L107 59 L112 61 L107 63 L105 68 L103 63 L98 61 L103 59 Z" />
      <path class="boot-star-c" d="M78 8 L80 12 L84 14 L80 16 L78 20 L76 16 L72 14 L76 12 Z" />
    </svg>
    <span class="boot-word">LunaDash</span>
  </div>
</div>
<a class="skip" href="#main">Skip to content</a>
<header class="nav wrap">
  <a class="brand" href="#main" aria-label="LunaDash home"><img src={asset("mark.svg")} alt="" width="28" height="28"> LunaDash</a>
  <nav aria-label="Main navigation"><a href="#gallery">Gallery</a><a href="#install">Install</a><a href={`${base}releases/`}>Release notes</a><a href={`${base}docs/start/`}>Guides</a><a class="source" href={repository}>GitHub <span aria-hidden="true">↗</span></a></nav>
</header>
<main id="main">
  <section class="hero wrap">
    <div class="hero-label"><span class="eyebrow">LUNADASH / WAYLAND DESKTOP</span><span class="preview-label">Development preview</span></div>
    <h1 class="tagline">Ready to use.<br><span>Yours to shape.</span></h1>
    <p class="hero-note">LunaDash is an open-source Linux Wayland desktop environment: a wlroots compositor and a shell written in Slint. Workspaces grow with your windows, tiling fills the screen or scrolls like niri, and the panel, dock, wallpapers and colours are yours to change.</p>
    <div class="actions">
      <a class="button primary" href="#install">Install LunaDash <span aria-hidden="true">↓</span></a>
      <a class="text-link" href={`${base}docs/desktop/`}>Tour the desktop ↗</a>
      <a class="text-link" href={repository}>Explore the source ↗</a>
    </div>
    <ScreenshotCard src={dashboard} featured title="Your everyday starting point" description="Dashboard, system status and useful shortcuts, together."
      alt="LunaDash dashboard showing a wallpaper preview, clock, system status and application shortcuts" />
  </section>

  <section id="desktop" class="wrap section">
    <span class="eyebrow">01 / THE IDEA</span>
    <div class="intro-grid">
      <div><h2>Start with a desktop.</h2><p>A panel, launcher, notifications, settings and file tools are already part of the experience. Dismiss the welcome screen and settle into your workspace.</p><a class="text-link" href="#start">Your first login ↓</a></div>
      <div><h2>Make it your own.</h2><p>Choose colours, glass, panel, dock, tiling and wallpapers in Settings. Go further by editing the Slint shell on <a class="inline-link" href={`${base}slintlu/`}>SlintLu</a> or scripting the local control interface.</p><a class="text-link" href={`${base}docs/settings/`}>Explore customization ↗</a></div>
    </div>
  </section>

  <section id="gallery" class="wrap section">
    <span class="eyebrow">02 / A LOOK AROUND</span>
    <div class="section-heading"><h2>One desktop. Your way.</h2><p>Actual screenshots from September 20, 2026.<br>Select an image to take a closer look.</p></div>
    <div class="gallery-grid">
      <ScreenshotCard src={appearance} title="Set the mood" description="Wallpaper and colors, from one settings center."
        alt="LunaDash Appearance settings with wallpaper selection and an accent color picker" />
      <ScreenshotCard src={workspace} title="Keep your tools close" description="Scrollable columns, grouped windows and familiar apps."
        alt="LunaDash workspace with a terminal beside grouped Discord and Zed windows" />
      <ScreenshotCard src={calendar} title="Make the details yours" description="A personal touch, right down to the calendar."
        alt="LunaDash desktop with the calendar panel and its customized header image" />
    </div>
  </section>

  <section id="install" class="wrap section">
    <span class="eyebrow">03 / INSTALL</span>
    <h2>Choose your installation.</h2>
    <p>Clone the development branch, then run <code>./scripts/install-session.sh</code>. It handles dependencies, builds LunaDash and installs the login session.</p>
    <CodeBlock label="INSTALL FROM THE DEV BRANCH" code={build} />
    <p>Log out and choose <strong>LunaDash</strong> in your display manager. Use <code>./scripts/install-session.sh --dry-run</code> to preview the installation. Options and recovery steps are in the <a class="inline-link" href={`${base}docs/start/`}>installation guide</a>.</p>
    <p>On NixOS, use the <a class="inline-link" href={`${base}docs/start/#nixos`}>flake and NixOS module</a> with <code>programs.lunadash.enable = true</code>. Updates and rollback use NixOS generations.</p>
    <div class="callout">An active development preview, built primarily on Arch Linux. The installer builds the compositor, the Slint shell and SlintLu (Rust) together. Keep your current desktop available while trying LunaDash.</div>
    <p class="coverage-note">Video wallpapers need mpvpaper. Native plugins stay disabled by default and execute without a sandbox when enabled.</p>
  </section>

  <section id="start" class="wrap section">
    <span class="eyebrow">04 / FIRST LOGIN</span>
    <h2>Getting started</h2>
    <p>The first login guides you through language, network and appearance. Then tap Super for the launcher, open the dashboard from the moon button and Settings from the gear.</p>
    <details class="shortcut-details"><summary>Keyboard shortcuts</summary>
    <p><strong>Super</strong> is the Meta key. The <a class="inline-link" href={`${base}docs/desktop/#shortcuts`}>desktop guide</a> lists every shortcut.</p>
    <div class="table-scroll">
      <table class="shortcuts" aria-label="Default keyboard shortcuts">
        <thead><tr><th scope="col">Shortcut</th><th scope="col">Action</th></tr></thead>
        <tbody>{shortcuts.map(([keys, action]) => <tr><th scope="row"><code>{keys}</code></th><td>{action}</td></tr>)}</tbody>
      </table>
    </div>
    <p>While you test in a nested session, your host desktop may intercept <code>Super</code> shortcuts first.</p>
    </details>
  </section>

  <section id="github" class="wrap section">
    <span class="eyebrow">05 / BUILD WITH US</span>
    <h2>Help shape the desktop.</h2>
    <p>Help make the default experience useful and customization approachable. Code, design feedback, documentation and bug reports all move LunaDash forward.</p>
    <p>Pull requests target <code>dev</code>. Choose a clear title, describe the user-visible change and the validation actually run, and include matching docs and website content updates. Do not change GitHub workflows or generated release notes; describe release impact in the PR body. Explain whether the change affects the defaults or an optional customization.</p>
    <div class="link-list">
      <a href={`${repository}/pulls`}>Pull requests <span aria-hidden="true">↗</span></a>
      <a href={`${repository}/blob/dev/CONTRIBUTING.md`}>Contribution guide <span aria-hidden="true">↗</span></a>
      <a href={`${base}docs/architecture/`}>Source architecture <span aria-hidden="true">↗</span></a>
      <a href={`${repository}/issues`}>Issues <span aria-hidden="true">↗</span></a>
      <a href={`${base}releases/`}>Website release notes <span aria-hidden="true">↗</span></a>
      <a href={`${repository}/releases`}>GitHub Releases <span aria-hidden="true">↗</span></a>
      <a href={`${repository}/blob/main/LICENSE`}>Licence <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section id="contributors" class="wrap section">
    <span class="eyebrow">06 / PEOPLE</span>
    <h2>Contributors</h2>
    <p>LunaDash is maintained by one person, with code, documentation and testing help from the community.</p>
    <ul class="contributors">
      <li><a class="contributor" href={profile}><img src={avatar} alt="LuYishan-4" width="72" height="72" loading="lazy"><span class="contributor-name">LuYishan-4</span><span class="contributor-role">Maintainer</span></a></li>
    </ul>
    <p>Open an issue or a pull request on <a class="inline-link" href={repository}>GitHub</a> to take part.</p>
  </section>
</main>
<dialog class="image-dialog" aria-labelledby="image-dialog-title">
  <div class="image-dialog-bar"><h2 id="image-dialog-title">Desktop screenshot</h2><button type="button" class="image-dialog-close" aria-label="Close screenshot">Close ×</button></div>
  <img class="image-dialog-image" alt="" width="1920" height="1080" />
  <a class="image-dialog-original" href="#gallery" target="_blank" rel="noopener">Open original image ↗</a>
</dialog>
<footer class="wrap">
  <a class="brand" href="#main"><img src={asset("mark.svg")} alt="" width="25" height="25"> LunaDash</a>
  <span>Ready to use. Yours to shape. · GPL-3.0-only</span>
  <a href={`${base}releases/`}>Release notes <span aria-hidden="true">↗</span></a>
</footer>
</body>
</html>
