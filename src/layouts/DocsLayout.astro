---
import "../styles.css";
import "../docs.css";
interface Props { title: string; summary: string; section: string; }
const { title, summary, section } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const lunadash = [
  ["start", "Install & first login"],
  ["desktop", "Using the desktop"],
  ["settings", "Settings"],
  ["shell", "Customize the shell"],
  ["plugins", "Compositor plugins"],
  ["api", "Control API"],
  ["architecture", "Architecture"],
];
const slintlu = [
  ["", "Overview"],
  ["api", "API reference"],
  ["ipc", "IPC and scripting"],
  ["theming", "Theming"],
  ["i18n", "Translations"],
  ["lockscreen", "Lock screen"],
];
const eyebrow = section.startsWith("slintlu-") ? `SLINTLU / ${section.slice(8).replace("index", "overview").toUpperCase()}` : `LUNADASH / ${section.toUpperCase()}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={summary} /><meta name="keywords" content="LunaDash, SlintLu, Linux desktop environment, Wayland desktop, wlroots, Slint, desktop shell, Linux desktop" /><meta name="theme-color" content="#101b1d" />
  <title>{title} · LunaDash Docs</title><link rel="icon" href={`${base}assets/mark.svg`} />
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<header class="nav wrap"><a class="brand" href={base}><img src={`${base}assets/mark.svg`} width="28" height="28" alt="" /> LunaDash <span class="docs-badge">GUIDES</span></a><nav aria-label="Main navigation"><a href={base}>Desktop</a><a href={`${base}slintlu/`}>SlintLu</a><a href={`${base}releases/`}>Release notes</a><a class="source" href="https://github.com/LuYishan-4/LunaDash/tree/dev">Source ↗</a></nav></header>
<div class="docs-layout wrap">
  <aside class="docs-sidebar">
    <span class="eyebrow">LUNADASH</span>
    <nav aria-label="LunaDash documentation">{lunadash.map(([id, label]) => <a href={`${base}docs/${id}/`} aria-current={section === id ? "page" : undefined}>{label}<span aria-hidden="true">↗</span></a>)}<a href={`${base}releases/`}>Release notes<span aria-hidden="true">↗</span></a></nav>
    <span class="eyebrow">SLINTLU TOOLKIT</span>
    <nav aria-label="SlintLu documentation">{slintlu.map(([id, label]) => <a href={`${base}slintlu/${id ? `${id}/` : ""}`} aria-current={section === `slintlu-${id || "index"}` ? "page" : undefined}>{label}<span aria-hidden="true">↗</span></a>)}</nav>
    <p>Development preview<br />Arch Linux first; NixOS module; Debian, Fedora and openSUSE install paths.</p>
  </aside>
  <main id="content" class="docs-main"><div class="eyebrow">{eyebrow}</div><h1>{title}</h1><p class="docs-lead">{summary}</p><slot /></main>
</div>
<footer class="wrap"><a class="brand" href={base}>LunaDash</a><span>Small details. Your workspace.</span><a href={`${base}releases/`}>Release notes ↗</a></footer>
</body>
</html>
